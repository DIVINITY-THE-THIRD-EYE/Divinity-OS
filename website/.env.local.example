# ── Brevo (contact form + email) ──────────────────────────────
# Get an API key at https://app.brevo.com  →  SMTP & API  →  API Keys
BREVO_API_KEY=
# Where enquiries are sent (your inbox)
BREVO_TO_EMAIL=hello@divinity.example
BREVO_TO_NAME=Divinity
# Verified sender in Brevo (Senders & IP)
BREVO_FROM_EMAIL=no-reply@divinity.example
BREVO_FROM_NAME=Divinity Website
# Optional: newsletter list id for the footer/Newsletter signup (Brevo → Contacts → Lists)
BREVO_LIST_ID=

# ── Sanity (optional CMS — site runs without it) ──────────────
# Create a free project at https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ── Certificate verification (optional — /verify page) ─────────
# Server-only env var (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Points at the Supabase Edge Function in ../supabase/functions/verify-certificate.
# Same Supabase project as the Flutter app. Site works fine without it (shows a
# graceful "contact the academy" fallback). See docs/SUPABASE_SETUP.md.
CERT_VERIFY_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/verify-certificate

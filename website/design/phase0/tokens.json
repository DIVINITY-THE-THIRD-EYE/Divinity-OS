{
  "$schema": "https://design-tokens.org/format",
  "version": "1.0.0",
  "name": "divinity-tokens",
  "frozen": "2026-06-26",
  "source": ["app/globals.css :root", "tailwind.config.ts theme.extend"],
  "color": {
    "primitive": {
      "void": "#15161E", "deep": "#1E2029", "smoke": "#2A2D38",
      "bone": "#ECE7DB", "bone-2": "#E2DCCB",
      "ember": "#D08A3E", "ember-deep": "#A85E2A", "ember-pale": "#E8C490", "clay": "#9C4A2A",
      "mist": "#8E93A6", "ink": "#20242F", "ink-mute": "#5C5F52",
      "line-dark": "rgba(208,138,62,0.16)", "line-light": "rgba(32,36,47,0.14)"
    },
    "semantic": {
      "bg": "{color.primitive.void}", "bg-raised": "{color.primitive.deep}", "bg-inset": "{color.primitive.smoke}",
      "bg-light": "{color.primitive.bone}", "bg-light-2": "{color.primitive.bone-2}",
      "fg": "{color.primitive.bone}", "fg-muted": "{color.primitive.mist}",
      "fg-on-light": "{color.primitive.ink}", "fg-on-light-muted": "{color.primitive.ink-mute}",
      "accent": "{color.primitive.ember}", "accent-strong": "{color.primitive.ember-deep}",
      "accent-soft": "{color.primitive.ember-pale}", "danger": "{color.primitive.clay}",
      "border-on-dark": "{color.primitive.line-dark}", "border-on-light": "{color.primitive.line-light}",
      "focus-ring": "{color.primitive.ember}"
    },
    "contrast_notes": {
      "bone_on_void": "13.7:1 AAA", "mist_on_void": "5.6:1 AA", "ember_on_void": "6.7:1 AA",
      "ink_on_bone": "12:1 AAA", "ember_on_bone": "FAILS body — use ember-deep (~4.7:1) for small text on light"
    }
  },
  "font": {
    "display": "var(--font-display), Georgia, serif",
    "body": "var(--font-body), system-ui, sans-serif",
    "mono": "var(--font-mono), monospace"
  },
  "text": {
    "xs": "clamp(11px,0.7rem + 0.1vw,12px)", "sm": "clamp(13px,0.8rem + 0.1vw,14px)",
    "base": "clamp(15px,0.95rem + 0.2vw,17px)", "lg": "clamp(18px,1.05rem + 0.3vw,21px)",
    "xl": "clamp(22px,1.2rem + 0.8vw,28px)", "2xl": "clamp(28px,1.4rem + 1.6vw,42px)",
    "3xl": "clamp(38px,2rem + 3vw,78px)", "hero": "clamp(72px,8vw + 1rem,210px)"
  },
  "leading": { "tight": 1.05, "snug": 1.25, "body": 1.85 },
  "tracking": { "label": "0.28em", "wide": "0.18em" },
  "space": { "0":"0","1":"4px","2":"8px","3":"12px","4":"16px","5":"24px","6":"32px","7":"48px","8":"64px","9":"96px","10":"128px","11":"160px",
    "section-y":"clamp(112px,12vw,160px)", "gutter":"clamp(24px,5vw,40px)", "container-max":"1152px" },
  "radius": { "none":"0","sm":"2px","md":"4px","lg":"8px","xl":"14px","pill":"999px" },
  "border": { "w":"1px","w2":"2px" },
  "elevation": { "0":"none",
    "1":"0 1px 2px rgba(32,36,47,.06), 0 1px 1px rgba(32,36,47,.04)",
    "2":"0 6px 20px rgba(32,36,47,.10)", "3":"0 18px 50px rgba(21,22,30,.30)" },
  "blur": { "sm":"6px","md":"12px","lg":"18px" },
  "opacity": { "faint":0.04,"muted":0.6,"hover":0.85,"hero-photo":0.28 },
  "zIndex": { "base":0,"raised":10,"promobar":200,"nav":300,"stickycta":310,"fab":320,"scrollbar":350,"mobilemenu":400,"palette":450,"lightbox":460 },
  "motion": {
    "ease-out":"cubic-bezier(0.22,1,0.36,1)", "ease-inout":"cubic-bezier(0.65,0,0.35,1)", "ease-emphasis":"cubic-bezier(0.16,1,0.3,1)",
    "spring-soft":{"stiffness":260,"damping":20},
    "dur-fast":"200ms","dur-base":"600ms","dur-slow":"900ms",
    "breath":{"inhale":"4s","hold":"4s","exhale":"6s"}
  },
  "breakpoints": { "sm":"640px","md":"768px","lg":"1024px","xl":"1280px","2xl":"1536px" }
}
